generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Puzzle {
  id        String   @id @default(uuid())
  title     String
  data      String   @db.LongText // JSON string containing grid, words, clues
  createdAt DateTime @default(now())
}
